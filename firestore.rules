rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user owns exactly one vault document, keyed by their
    // own auth uid. Nobody — including other signed-in users — can read or
    // write a vault that isn't theirs.
    match /vaults/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
